{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "PowerShell(git status *)",
      "PowerShell(git diff *)",
      "PowerShell(git log *)",
      "PowerShell(git check-ignore *)",
      "PowerShell(docker compose ps *)",
      "PowerShell(docker compose up *)"
    ],
    "ask": [
      "PowerShell(git commit *)",
      "PowerShell(git push *)",
      "PowerShell(git reset *)",
      "PowerShell(git add *)",
      "PowerShell(git stash *)",
      "PowerShell(git checkout *)",
      "PowerShell(git switch *)",
      "PowerShell(git restore *)",
      "PowerShell(git rebase *)",
      "PowerShell(git clean *)",
      "PowerShell(docker compose down *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git reset *)",
      "Bash(git add *)",
      "Bash(git stash *)",
      "Bash(git checkout *)",
      "Bash(git switch *)",
      "Bash(git restore *)",
      "Bash(git rebase *)",
      "Bash(git clean *)",
      "Bash(docker compose down *)"
    ],
    "deny": [
      "Read(./.env)"
    ]
  }
}